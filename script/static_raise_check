#!/bin/sh
# Spinel turns a call it cannot resolve into an unconditional raise in
# the generated C, which only shows up when that line runs. This compiles
# to C and fails when any such raise is there.
cd "$(dirname "$0")/.."
SPINEL=${SPINEL:-$(command -v spinel)}
if [ -z "$SPINEL" ]; then
  echo "Spinel not found: put spinel on PATH or set SPINEL=/path/to/spinel/bin/spinel" >&2
  exit 1
fi
mkdir -p build
[ "$(uname)" = Linux ] && entry=bin/spinel_studio_linux.rb || entry=bin/spinel_studio.rb
"$SPINEL" -c "$entry" -o build/spinel_studio.c >/dev/null 2>&1 || { echo "static raise check: compile to C failed"; exit 1; }
found=$(grep -o 'sp_raise_nomethod(sp_stage_recv_args_msg("[^"]*"' build/spinel_studio.c | sed 's/.*msg("//; s/"$//' | sort | uniq -c)
if [ -n "$found" ]; then
  echo "static raise check FAIL:"
  echo "$found"
  exit 1
fi
echo "static raise check PASS"
